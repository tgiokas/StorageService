# Azure Blob
AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=xxxxxxxxx;AccountKey=yyyyyyyy;EndpointSuffix=core.windows.net

# SeaweedFS
